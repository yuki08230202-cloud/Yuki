# ===== 安全フラグ（本番化は DRY_RUN 検証と管理者承認の後に false へ） =====
DRY_RUN=true
NOTIFY_DRY_RUN=true

BASE_URL=https://enpra-xxxxx-an.a.run.app
DATABASE_URL=sqlite:///./enpra.db
# 本番: postgresql+psycopg://USER:PASS@/enpra?host=/cloudsql/PROJECT:asia-northeast1:enpra-db

# ===== 管理者 =====
ADMIN_NAME=渡邉勇貴
ADMIN_CHATWORK_ID=i4snxm1oompx
ADMIN_ACCOUNT_ID=            # python -m enpra.cli verify の GET /me 結果の account_id
ADMIN_PASSWORD_HASH=         # python -m enpra.cli hash-password
SESSION_SECRET=              # openssl rand -hex 32
JOB_SECRET=                  # openssl rand -hex 32（Cloud Scheduler のヘッダに設定）

# ===== Chatwork =====
CHATWORK_API_TOKEN=          # 管理者アカウントの API トークン（ワーカー向け操作）
CHATWORK_NOTIFY_TOKEN=       # 通知用 Bot アカウントのトークン（推奨）
ADMIN_NOTIFY_ROOM_ID=        # Bot と管理者のダイレクトチャットの room_id
RECRUIT_ROOM_ID=             # ワーカーグループ
QUESTION_ROOM_IDS=           # 質問を監視するルーム（カンマ区切り）
REPORT_ROOM_ID=              # 終了報告ルーム（未設定なら RECRUIT_ROOM_ID）
INVOICE_ROOM_ID=             # 中島さんとのチャット
CHATWORK_WEBHOOK_TOKEN=
CONTACT_LIMIT=20
CONTACT_WARN_AT=15

RECRUIT_PREPARE_TIME=18:30
RECRUIT_SEND_TIME=19:00
PARTICIPATION_DEADLINE=22:00
APPROVAL_TOKEN_TTL_HOURS=24

# ===== 代替通知（メール） =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=               # Gmail はアプリパスワード
SMTP_FROM=
ADMIN_EMAIL=

# ===== Google Sheets =====
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE= # Cloud Run ではサービスアカウントの ADC を使うため空でよい
SHEET_RECORD_TAB=企業フォーム送付_記録
SHEET_WORKLOG_TAB=

# ===== Claude API（FAQ 回答案。任意） =====
LLM_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
